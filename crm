<!DOCTYPE html>
<html lang="ru" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Опрос команды — Удобство и сервис</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            transition: background-color 0.25s ease, color 0.25s ease;
        }
        .rating-btn {
            transition: all 0.16s cubic-bezier(0.4, 0, 0.2, 1);
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        .rating-btn:active {
            transform: scale(0.96);
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeIn 0.25s ease-out forwards;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.2);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.45);
            border-radius: 9999px;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-900 dark:bg-[#080b14] dark:text-slate-100 min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white">

    <!-- Контейнер всплывающих уведомлений (вместо alert) -->
    <div id="toastContainer" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <!-- ========================================================================= -->
    <!-- МОДАЛЬНОЕ ОКНО: ВХОД В CRM КУРАТОРА (БЕЗ ПОДСКАЗОК И БЕЗ УПОМИНАНИЯ ЮЗА) -->
    <!-- ========================================================================= -->
    <div id="crmLoginModal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#111625] border border-slate-200 dark:border-slate-800/90 rounded-2xl max-w-sm w-full p-6 shadow-2xl animate-fade-in space-y-5">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-indigo-500/15 text-indigo-400 flex items-center justify-center">
                        <i class="fa-solid fa-user-shield text-lg"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-base text-slate-900 dark:text-white">Закрытая панель управления</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Авторизация доступа</p>
                    </div>
                </div>
                <button type="button" onclick="toggleModal('crmLoginModal')" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1.5 rounded-lg transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="space-y-2">
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400">
                    КЛЮЧ ДОСТУПА
                </label>
                <div class="relative">
                    <input
                        type="password"
                        id="crmSecretInput"
                        placeholder="••••••••"
                        autocomplete="off"
                        onkeydown="if(event.key==='Enter') unlockCrmView()"
                        class="w-full pl-3.5 pr-10 py-3 rounded-xl bg-slate-50 dark:bg-[#0b0f1a] border border-slate-200 dark:border-slate-800 text-sm focus:outline-none focus:border-indigo-500 transition tracking-widest"
                    >
                    <button
                        type="button"
                        onclick="togglePasswordVisibility()"
                        class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-300 transition"
                        title="Показать / скрыть"
                    >
                        <i id="eyeIcon" class="fa-regular fa-eye text-sm"></i>
                    </button>
                </div>
                <p id="crmLoginError" class="hidden text-xs text-rose-500 font-medium pt-0.5">
                    <i class="fa-solid fa-circle-exclamation mr-1"></i> Неверный ключ доступа
                </p>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-1">
                <button type="button" onclick="toggleModal('crmLoginModal')" class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800/90 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-semibold transition">
                    Отмена
                </button>
                <button type="button" onclick="unlockCrmView()" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/25 transition">
                    Открыть CRM
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- МОДАЛЬНОЕ ОКНО: НАСТРОЙКА ПУБЛИЧНОГО ДОМЕНА CRM И СКАЧИВАНИЕ ФАЙЛА        -->
    <!-- ========================================================================= -->
    <div id="domainModal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#111625] border border-slate-200 dark:border-slate-800 rounded-2xl max-w-lg w-full p-6 shadow-2xl animate-fade-in space-y-4">
            <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3.5">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/15 text-emerald-400 flex items-center justify-center">
                        <i class="fa-solid fa-globe text-lg"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-base">Как сделать красивую ссылку (домен CRM)</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Чтобы скидывать опрос любому человеку на телефон или ПК</p>
                    </div>
                </div>
                <button type="button" onclick="toggleModal('domainModal')" class="text-slate-400 hover:text-slate-200 p-1.5 rounded-lg">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="space-y-3 text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 space-y-2">
                    <div class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <span class="w-5 h-5 rounded-full bg-indigo-600 text-white text-xs flex items-center justify-center">1</span>
                        Быстрая ссылка через кнопку Share
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        Нажмите кнопку <b>Share / Поделиться</b> в правом верхнем углу окна предпросмотра — скопируйте публичную ссылку и отправьте сотрудникам.
                    </p>
                </div>

                <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 space-y-2.5">
                    <div class="font-bold text-slate-900 dark:text-white flex items-center gap-2">
                        <span class="w-5 h-5 rounded-full bg-emerald-600 text-white text-xs flex items-center justify-center">2</span>
                        Свой домен вида <code class="text-emerald-400">https://crm-team.netlify.app</code> за 10 секунд
                    </div>
                    <ol class="list-decimal list-inside space-y-1 text-xs text-slate-500 dark:text-slate-400">
                        <li>Нажмите кнопку <b>«Скачать файл index.html»</b> ниже.</li>
                        <li>Перетащите скачанный файл на страницу <b>drop.netlify.com</b> или <b>vercel.com</b>.</li>
                        <li>Вы мгновенно получите красивую внешнюю ссылку: сотрудники будут видеть только опрос, а вы по кнопке <b>🔒 CRM</b> внизу страницы сможете заходить в свою CRM.</li>
                    </ol>
                    <button type="button" onclick="downloadStandaloneHtml()" class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/20 transition">
                        <i class="fa-solid fa-download"></i> Скачать файл index.html
                    </button>
                </div>
            </div>

            <div class="flex justify-end pt-1">
                <button type="button" onclick="toggleModal('domainModal')" class="px-4 py-2 rounded-xl bg-slate-200 dark:bg-slate-800 text-xs font-semibold">
                    Понятно
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- МОДАЛЬНОЕ ОКНО: БЕЗОПАСНАЯ НАСТРОЙКА TELEGRAM (БЕЗ GETUPDATES)            -->
    <!-- ========================================================================= -->
    <div id="tgSetupModal" class="fixed inset-0 z-50 hidden bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-[#111625] border border-slate-200 dark:border-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl animate-fade-in space-y-4">
            <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-sky-500/15 text-sky-400 flex items-center justify-center">
                        <i class="fa-brands fa-telegram text-lg"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-base">Дублирование анкет в Telegram</h3>
                        <p class="text-[11px] text-emerald-400 font-medium">Безопасный режим (только односторонняя отправка)</p>
                    </div>
                </div>
                <button type="button" onclick="toggleModal('tgSetupModal')" class="text-slate-400 hover:text-slate-200 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <div class="text-xs text-slate-500 dark:text-slate-400 space-y-2 leading-relaxed">
                <p>
                    Все анкеты сотрудников уже <b>автоматически сохраняются в эту CRM</b>. Если хотите, чтобы бот дополнительно присылал копию анкеты вам в личку:
                </p>
                <ol class="list-decimal list-inside space-y-1 text-slate-600 dark:text-slate-300">
                    <li>Напишите своему боту <b>/start</b>.</li>
                    <li>Узнайте свой цифровой <b>Chat ID</b> (например, через <code class="text-sky-400">@userinfobot</code> в TG).</li>
                    <li>Вставьте ваш цифровой ID ниже и нажмите «Сохранить».</li>
                </ol>
            </div>

            <div>
                <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">
                    Ваш цифровой Telegram Chat ID (необязательно)
                </label>
                <input
                    type="text"
                    id="curatorChatIdInput"
                    placeholder="Например: 718293045"
                    class="w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-[#0b0f1a] border border-slate-200 dark:border-slate-800 text-sm focus:outline-none focus:border-sky-500"
                >
            </div>

            <div class="flex items-center justify-between gap-2 pt-2">
                <button type="button" onclick="testTelegramPush()" class="px-3.5 py-2.5 rounded-xl bg-sky-500/15 hover:bg-sky-500/25 text-sky-400 text-xs font-semibold transition">
                    <i class="fa-regular fa-paper-plane mr-1"></i> Проверить отправку
                </button>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="toggleModal('tgSetupModal')" class="px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-semibold">
                        Закрыть
                    </button>
                    <button type="button" onclick="saveCuratorChatId()" class="px-4 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/25">
                        Сохранить ID
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- РЕЖИМ 1: ЧИСТЫЙ ОПРОС ДЛЯ СОТРУДНИКОВ (ОТКРЫВАЕТСЯ ПО УМОЛЧАНИЮ)          -->
    <!-- ========================================================================= -->
    <div id="surveyView" class="flex-1 flex flex-col justify-between py-6 px-4 sm:px-6">
        <div class="max-w-xl w-full mx-auto space-y-5">

            <!-- Верхняя карточка-шапка опроса -->
            <div class="bg-white dark:bg-[#111625] rounded-2xl border border-slate-200 dark:border-slate-800/90 p-5 shadow-sm flex items-center justify-between gap-3">
                <div class="flex items-center gap-3.5">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/25 shrink-0">
                        <i class="fa-brands fa-tiktok text-xl"></i>
                    </div>
                    <div>
                        <div class="flex flex-wrap items-center gap-2">
                            <h1 class="font-extrabold text-base sm:text-lg tracking-tight">Опрос команды: Удобство и сервис</h1>
                        </div>
                        <div class="mt-1 inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                            Этап: В работе (прогрев TikTok)
                        </div>
                    </div>
                </div>

                <!-- Переключатель темы -->
                <button type="button" onclick="toggleTheme()" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700/80 transition shrink-0" title="Тема оформления">
                    <i class="fa-solid fa-sun hidden dark:inline-block text-amber-400"></i>
                    <i class="fa-solid fa-moon inline-block dark:hidden text-slate-700"></i>
                </button>
            </div>

            <!-- Основная карточка анкеты -->
            <div id="surveyFormCard" class="bg-white dark:bg-[#111625] rounded-2xl border border-slate-200 dark:border-slate-800/90 p-5 sm:p-6 shadow-sm space-y-6">

                <!-- 1. Ник сотрудника в Telegram (полностью пустое поле по умолчанию) -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">
                        Ваш ник в Telegram <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-indigo-400">
                            <i class="fa-brands fa-telegram text-base"></i>
                        </span>
                        <input
                            type="text"
                            id="empUsername"
                            value=""
                            autocomplete="off"
                            placeholder="Введите ваш @username"
                            class="w-full pl-10 pr-4 py-3 rounded-xl bg-slate-50 dark:bg-[#0b0f1a] border border-slate-200 dark:border-slate-800 text-sm focus:outline-none focus:border-indigo-500 transition"
                        >
                    </div>
                </div>

                <!-- 2. Вопросы с кнопками «Плохо» / «Хорошо» / «Отлично» (НИ ОДНА НЕ ВЫБРАНА ПО УМОЛЧАНИЮ) -->
                <div class="space-y-4">
                    <!-- Вопрос 1 -->
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#0b0f1a] border border-slate-200/80 dark:border-slate-800/80 space-y-3">
                        <div class="text-xs sm:text-sm font-semibold leading-snug">
                            1. Насколько удобен наш сервис и рабочие инструменты (прокси, аккаунты, таблицы)? <span class="text-rose-500">*</span>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" onclick="setRating('q1', 'bad')" class="rating-btn q1-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] text-slate-600 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1.5" data-val="bad">
                                <i class="fa-regular fa-face-frown text-rose-500"></i> Плохо
                            </button>
                            <button type="button" onclick="setRating('q1', 'good')" class="rating-btn q1-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] text-slate-600 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1.5" data-val="good">
                                <i class="fa-regular fa-face-smile text-amber-400"></i> Хорошо
                            </button>
                            <button type="button" onclick="setRating('q1', 'great')" class="rating-btn q1-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] text-slate-600 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1.5" data-val="great">
                                <i class="fa-regular fa-face-grin-stars text-emerald-400"></i> Отлично
                            </button>
                        </div>
                    </div>

                    <!-- Вопрос 2 -->
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#0b0f1a] border border-slate-200/80 dark:border-slate-800/80 space-y-3">
                        <div class="text-xs sm:text-sm font-semibold leading-snug">
                            2. Насколько понятны мануалы, шаблоны и алгоритмы прогрева TikTok? <span class="text-rose-500">*</span>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" onclick="setRating('q2', 'bad')" class="rating-btn q2-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] text-slate-600 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1.5" data-val="bad">
                                <i class="fa-regular fa-face-frown text-rose-500"></i> Плохо
                            </button>
                            <button type="button" onclick="setRating('q2', 'good')" class="rating-btn q2-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] text-slate-600 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1.5" data-val="good">
                                <i class="fa-regular fa-face-smile text-amber-400"></i> Хорошо
                            </button>
                            <button type="button" onclick="setRating('q2', 'great')" class="rating-btn q2-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] text-slate-600 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1.5" data-val="great">
                                <i class="fa-regular fa-face-grin-stars text-emerald-400"></i> Отлично
                            </button>
                        </div>
                    </div>

                    <!-- Вопрос 3 -->
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#0b0f1a] border border-slate-200/80 dark:border-slate-800/80 space-y-3">
                        <div class="text-xs sm:text-sm font-semibold leading-snug">
                            3. Как вы оцениваете удобство и стабильность работы на вашем устройстве? <span class="text-rose-500">*</span>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" onclick="setRating('q3', 'bad')" class="rating-btn q3-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] text-slate-600 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1.5" data-val="bad">
                                <i class="fa-regular fa-face-frown text-rose-500"></i> Плохо
                            </button>
                            <button type="button" onclick="setRating('q3', 'good')" class="rating-btn q3-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] text-slate-600 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1.5" data-val="good">
                                <i class="fa-regular fa-face-smile text-amber-400"></i> Хорошо
                            </button>
                            <button type="button" onclick="setRating('q3', 'great')" class="rating-btn q3-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] text-slate-600 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1.5" data-val="great">
                                <i class="fa-regular fa-face-grin-stars text-emerald-400"></i> Отлично
                            </button>
                        </div>
                    </div>

                    <!-- Вопрос 4 -->
                    <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#0b0f1a] border border-slate-200/80 dark:border-slate-800/80 space-y-3">
                        <div class="text-xs sm:text-sm font-semibold leading-snug">
                            4. Насколько быстро и понятно помогает куратор при разборе вопросов? <span class="text-rose-500">*</span>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <button type="button" onclick="setRating('q4', 'bad')" class="rating-btn q4-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] text-slate-600 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1.5" data-val="bad">
                                <i class="fa-regular fa-face-frown text-rose-500"></i> Плохо
                            </button>
