            const box = document.getElementById('curatorHelpContainer');
            if (needCuratorHelpActive) {
                btn.className = 'px-4 py-2 rounded-xl text-xs font-bold border border-rose-500 bg-rose-600 text-white shadow-lg shadow-rose-600/25 flex items-center gap-1.5 transition';
                box.classList.remove('hidden');
