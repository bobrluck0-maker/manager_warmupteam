                box.classList.add('hidden');
            }
        };

        // 5. Отправка анкеты сотрудником (сохраняется строго то, что ввел и выбрал сам человек)
        window.submitEmployeeSurvey = async function() {
            let rawUsername = document.getElementById('empUsername').value.trim();
            const opinionText = document.getElementById('empOpinion').value.trim();
            const helpProblemText = document.getElementById('curatorHelpText').value.trim();

            if (!rawUsername) {
                showToast('Пожалуйста, введите ваш ник в Telegram (@username)', 'error');
                document.getElementById('empUsername').focus();
                return;
            }
            const exactUsername = rawUsername.startsWith('@') ? rawUsername : '@' + rawUsername;

            // Проверяем, что сотрудник сам выбрал оценку в каждом из 5 вопросов
            const unanswered = ['q1', 'q2', 'q3', 'q4', 'q5'].filter(q => !currentRatings[q]);
            if (unanswered.length > 0) {
                showToast('Пожалуйста, выберите оценку («Плохо», «Хорошо» или «Отлично») для всех 5 вопросов', 'error');
                return;
            }

            // Если сотрудник сам нажал «Нужна помощь куратора», он должен описать проблему своими словами
            if (needCuratorHelpActive && !helpProblemText) {
                showToast('Опишите вашу проблему в открывшемся поле помощи куратора', 'error');
                document.getElementById('curatorHelpText').focus();
                return;
            }

            // Собираем только те кнопки сложностей, которые реально нажал сам сотрудник
            const selectedTags = [];
            document.querySelectorAll('#painPointsGroup .tag-selected').forEach(el => {
                selectedTags.push(el.getAttribute('data-tag'));
            });

            // Расчет общей оценки по ответам пользователя
            const vals = Object.values(currentRatings);
            const badCnt = vals.filter(v => v === 'bad').length;
            const greatCnt = vals.filter(v => v === 'great').length;
            let overall = 'good';
            if (badCnt >= 1) overall = 'bad';
            else if (greatCnt >= 3 && badCnt === 0) overall = 'great';

            const payload = {
                username: exactUsername,
                stage: FIXED_STAGE,
                ratings: { ...currentRatings },
                overall,
                tags: selectedTags,
                needHelp: needCuratorHelpActive,
                helpProblem: needCuratorHelpActive ? helpProblemText : '',
                opinion: opinionText !== '' ? opinionText : 'Без комментария',
                status: 'new',
                createdAt: Date.now()
            };

            const submitBtn = document.getElementById('submitSurveyBtn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>Отправка...</span>`;

            // Сохраняем в облачную базу CRM (Firestore)
            try {
                if (db && currentUser) {
                    const surveyCol = collection(db, 'artifacts', appId, 'public', 'data', 'survey_responses');
                    await addDoc(surveyCol, payload);
                } else {
                    submissions.unshift({ id: 'local-' + Date.now(), ...payload });
                    renderCrmSubmissions();
                }
            } catch (err) {
                console.warn('Локальное сохранение анкеты:', err);
                submissions.unshift({ id: 'local-' + Date.now(), ...payload });
                renderCrmSubmissions();
            }

            // Односторонняя отправка в Telegram (если задан числовой Chat ID)
            if (savedTelegramChatId) {
                sendSafeTelegramNotification(payload, savedTelegramChatId);
            }

            submitBtn.disabled = false;
            submitBtn.innerHTML = `<i class="fa-solid fa-paper-plane"></i> <span>Отправить анкету</span>`;

            // Показываем экран успеха
            document.getElementById('surveyFormCard').classList.add('hidden');
            document.getElementById('surveySuccessCard').classList.remove('hidden');
            showToast('Ваш ответ успешно отправлен!', 'success');
        };

        // Полный сброс формы к чистым значениям (ничего не выбрано)
        window.resetSurveyForm = function() {
            document.getElementById('empUsername').value = '';
            document.getElementById('empOpinion').value = '';
