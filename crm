                    btn.className += 'border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] text-slate-600 dark:text-slate-300 hover:border-slate-400';
                }
            });
        };

        // 4. Переключение тегов сложностей (БЕЗ КАКОГО-ЛИБО АВТОМАТИЧЕСКОГО ТЕКСТА)
        window.toggleTag = function(btn) {
