        // 6. Безопасная отправка уведомления через POST sendMessage (строго то, что ввел сотрудник)
        async function sendSafeTelegramNotification(item, chatId) {
            const wordMap = { great: '🟢 Отлично', good: '🟡 Хорошо', bad: '🔴 Плохо' };
            const tagsLine = (item.tags && item.tags.length > 0)
                ? `\n<b>Выбранные сложности:</b> ${item.tags.map(escapeHtml).join(', ')}`
                : '';
            const helpBlock = item.needHelp
                ? `\n\n🆘 <b>НУЖНА ПОМОЩЬ КУРАТОРА:</b>\n${escapeHtml(item.helpProblem)}`
                : '';

            const text =
                `📋 <b>Новая анкета сотрудника!</b>\n` +
                `👤 <b>Сотрудник:</b> ${escapeHtml(item.username)}\n` +
                `📌 <b>Этап:</b> ${escapeHtml(item.stage)}\n\n` +
                `<b>Блок 1 — Оценки:</b>\n` +
                `• Сервис и инструменты: ${wordMap[item.ratings.q1] || '—'}\n` +
                `• Мануалы и шаблоны: ${wordMap[item.ratings.q2] || '—'}\n` +
                `• Устройство: ${wordMap[item.ratings.q3] || '—'}\n` +
                `• Помощь куратора: ${wordMap[item.ratings.q4] || '—'}\n` +
                `• Учет и выплаты: ${wordMap[item.ratings.q5] || '—'}` +
                tagsLine +
                helpBlock +
                `\n\n💬 <b>Мнение и предложения:</b>\n${escapeHtml(item.opinion || 'Без комментария')}`;

            try {
                await fetch(`https://api.telegram.org/bot${TG_BOT_TOKEN}/sendMessage`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        chat_id: chatId,
                        text: text,
                        parse_mode: 'HTML'
                    })
                });
            } catch (e) {
                console.warn('Не удалось продублировать в TG:', e);
            }
        }

