    <!-- ========================================================================= -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, addDoc, setDoc, getDoc, updateDoc, deleteDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // 1. Константы и начальное состояние (НИКАКИХ ПРЕДВЫБРАННЫХ ОЦЕНОК ИЛИ ДАННЫХ)
        const TG_BOT_TOKEN = "9041106403:AAFsXkWX054YLt2VlRlPwMJTZhAs9tHIutU";
        const FIXED_STAGE = "В работе (прогрев TikTok)";

        let currentRatings = {
            q1: null,
            q2: null,
            q3: null,
            q4: null,
            q5: null
        };
        let needCuratorHelpActive = false;
        let isCrmUnlocked = false;
        let currentCrmFilter = 'all';
        let savedTelegramChatId = "";

        const questionLabels = {
            q1: '1. Сервис и инструменты',
            q2: '2. Мануалы и шаблоны',
            q3: '3. Стабильность устройства',
            q4: '4. Помощь куратора',
            q5: '5. Учет и выплаты'
        };

        // Список анкет изначально полностью пустой — никаких фейковых worker_01 / worker_02
        let submissions = [];

        // 2. Инициализация Firebase Firestore (согласно 3 обязательным правилам)
        let db = null;
        let auth = null;
        let currentUser = null;
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';

        async function initCloudStorage() {
            try {
                if (typeof __firebase_config === 'undefined' || !__firebase_config) {
                    renderCrmSubmissions();
                    return;
                }
                const firebaseConfig = JSON.parse(__firebase_config);
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                // Правило 3: Строго сначала авторизация
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }

                onAuthStateChanged(auth, async (user) => {
                    currentUser = user;
                    if (!user) return;

                    // Загружаем сохраненный Chat ID куратора (если был указан)
                    try {
                        const cfgRef = doc(db, 'artifacts', appId, 'public', 'data', 'crm_settings', 'telegram_config');
                        const cfgSnap = await getDoc(cfgRef);
                        if (cfgSnap.exists() && cfgSnap.data().chatId) {
                            savedTelegramChatId = String(cfgSnap.data().chatId).trim();
                            document.getElementById('curatorChatIdInput').value = savedTelegramChatId;
                            updateTgStatusUi();
                        }
                    } catch (e) {
                        console.warn('Не удалось прочитать настройки TG:', e);
                    }

                    // Правило 1 и 2: Подписка на публичную коллекцию реальных анкет
                    const surveyCol = collection(db, 'artifacts', appId, 'public', 'data', 'survey_responses');
                    onSnapshot(
                        surveyCol,
                        (snapshot) => {
                            const cloudItems = [];
                            snapshot.forEach((docSnap) => {
                                cloudItems.push({ id: docSnap.id, ...docSnap.data() });
                            });
                            // Сортируем по времени (новые сверху) и записываем ровно то, что есть в базе
                            cloudItems.sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
                            submissions = cloudItems;
                            renderCrmSubmissions();
                        },
                        (error) => {
                            console.error('Ошибка синхронизации анкет:', error);
                        }
                    );
                });
            } catch (err) {
                console.warn('Работаем в автономном режиме памяти:', err);
                renderCrmSubmissions();
            }
        }

        // 3. Управление кнопками «Плохо» / «Хорошо» / «Отлично»
        window.setRating = function(questionId, value) {
            currentRatings[questionId] = value;
            const buttons = document.querySelectorAll(`.${questionId}-btn`);
            buttons.forEach(btn => {
                const v = btn.getAttribute('data-val');
                btn.className = `rating-btn ${questionId}-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold border flex items-center justify-center gap-1.5 `;
                if (v === value) {
                    if (value === 'bad') {
                        btn.className += 'border-rose-500 bg-rose-500/15 text-rose-600 dark:text-rose-300 shadow-sm';
                    } else if (value === 'good') {
