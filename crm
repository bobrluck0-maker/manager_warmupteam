        // 8. Отрисовка CRM Куратора (строго без шаблонных приписок)
        window.setCrmFilter = function(filterName) {
            currentCrmFilter = filterName;
            ['all', 'help', 'unread', 'bad'].forEach(f => {
                const btn = document.getElementById(`flt-${f}`);
