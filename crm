                document.querySelectorAll(`.${q}-btn`).forEach(btn => {
                    btn.className = `rating-btn ${q}-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111625] text-slate-600 dark:text-slate-300 hover:border-slate-400 flex items-center justify-center gap-1.5`;
                });
            });

            // Сбрасываем все кнопки сложностей
            document.querySelectorAll('#painPointsGroup .pain-tag').forEach(btn => {
                btn.classList.remove('tag-selected', 'border-indigo-500', 'bg-indigo-500/15', 'text-indigo-500', 'dark:text-indigo-300');
