        // 9. Настройка безопасного Telegram Chat ID
        window.saveCuratorChatId = async function() {
            const val = document.getElementById('curatorChatIdInput').value.trim();
            savedTelegramChatId = val;
            updateTgStatusUi();

            if (db && currentUser) {
                try {
                    const cfgRef = doc(db, 'artifacts', appId, 'public', 'data', 'crm_settings', 'telegram_config');
                    await setDoc(cfgRef, { chatId: val, updatedAt: Date.now() });
