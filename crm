            const nextStatus = target.status === 'done' ? 'new' : 'done';
            target.status = nextStatus;
            renderCrmSubmissions();

            if (db && currentUser && !String(id).startsWith('local-')) {
                try {
                    const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'survey_responses', id);
                    await updateDoc(docRef, { status: nextStatus });
