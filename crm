                            <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-200 bg-slate-50 dark:bg-[#0b0f1a] p-3.5 rounded-xl border border-slate-200/60 dark:border-slate-800 whitespace-pre-wrap">${escapeHtml(opinionDisplay)}</p>
                        </div>
                    </div>
