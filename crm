                }
            });
            renderCrmSubmissions();
        };

        window.renderCrmSubmissions = function() {
            const total = submissions.length;
            const helpCount = submissions.filter(s => s.needHelp).length;

            let qTotal = 0;
            let points = 0;
            submissions.forEach(s => {
                if (s.ratings) {
                    Object.values(s.ratings).forEach(v => {
                        if (!v) return;
                        qTotal++;
                        if (v === 'great') points += 100;
                        else if (v === 'good') points += 70;
                        else if (v === 'bad') points += 20;
                    });
                }
            });
            const avgComfort = qTotal > 0 ? `${Math.round(points / qTotal)}%` : '—';

            document.getElementById('crmTotalCount').textContent = total;
            document.getElementById('crmAvgComfort').textContent = avgComfort;
            document.getElementById('crmHelpCount').textContent = helpCount;

            const search = (document.getElementById('crmSearchInput')?.value || '').trim().toLowerCase();
            const filtered = submissions.filter(item => {
                if (currentCrmFilter === 'help' && !item.needHelp) return false;
                if (currentCrmFilter === 'unread' && item.status === 'done') return false;
                if (currentCrmFilter === 'bad' && item.overall !== 'bad') return false;

                if (search) {
                    const hay = `${item.username || ''} ${item.opinion || ''} ${item.helpProblem || ''} ${(item.tags || []).join(' ')}`.toLowerCase();
                    if (!hay.includes(search)) return false;
                }
                return true;
            });

            const container = document.getElementById('crmSubmissionsList');
            if (!container) return;

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="bg-white dark:bg-[#111625] rounded-2xl border border-slate-200 dark:border-slate-800 p-10 text-center space-y-2">
                        <div class="text-slate-400 text-sm font-semibold">Реальных анкет от сотрудников пока нет</div>
                        <div class="text-xs text-slate-500">Как только сотрудник заполнит опрос и нажмет «Отправить анкету», его ответ сразу появится здесь.</div>
                    </div>
                `;
                return;
            }

            container.innerHTML = filtered.map(item => {
                const dateStr = formatTime(item.createdAt);
                const cleanTgUser = (item.username || '').replace(/^@/, '');

                // Блок 1 — Оценки (5 вопросов)
                const ratingPills = ['q1', 'q2', 'q3', 'q4', 'q5'].map(k => {
                    const val = item.ratings ? item.ratings[k] : null;
                    const cls = val === 'great'
                        ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'
                        : val === 'good'
                        ? 'bg-amber-500/10 text-amber-400 border-amber-500/20'
                        : val === 'bad'
                        ? 'bg-rose-500/10 text-rose-400 border-rose-500/20'
                        : 'bg-slate-500/10 text-slate-400 border-slate-500/20';
                    const label = val === 'great' ? 'Отлично' : val === 'good' ? 'Хорошо' : val === 'bad' ? 'Плохо' : '—';
                    return `<span class="px-2.5 py-1 rounded-lg text-[11px] font-semibold border ${cls}">${questionLabels[k]}: <b>${label}</b></span>`;
                }).join('');

                // Выбранные сложности (строго простые плашки выбранных кнопок без авто-текста)
                const userTags = Array.isArray(item.tags) ? item.tags.filter(t => t && t !== 'Без замечаний' && t !== 'Нужна помощь куратора') : [];
                const tagsBadgesHtml = userTags.length > 0
                    ? userTags.map(t => `<span class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">${escapeHtml(t)}</span>`).join('')
                    : `<span class="text-xs text-slate-500">Не выбрано</span>`;

                // Блок 2 — Запрос «🆘 Нужна помощь куратора» (показывается только если сотрудник сам нажал кнопку, и содержит только его текст)
                const helpAlertHtml = item.needHelp
                    ? `
                    <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/30 space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold text-rose-400 flex items-center gap-1.5">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Блок 2 — Запрос «🆘 Нужна помощь куратора»
                            </span>
                            <a href="https://t.me/${encodeURIComponent(cleanTgUser)}" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-rose-300 hover:text-white underline flex items-center gap-1">
                                <i class="fa-brands fa-telegram"></i> Ответить ${escapeHtml(item.username)}
                            </a>
                        </div>
                        <p class="text-xs sm:text-sm text-rose-100 leading-relaxed font-medium whitespace-pre-wrap">${escapeHtml(item.helpProblem)}</p>
                    </div>
                    `
                    : '';

                // Блок 3 — «Мнение и предложения» (строго текст сотрудника или «Без комментария»)
                const opinionDisplay = (item.opinion && item.opinion.trim() !== '') ? item.opinion : 'Без комментария';

                const isDone = item.status === 'done';
                const statusBadge = isDone
                    ? `<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/20"><i class="fa-solid fa-check mr-1"></i>Разобрано</span>`
                    : `<span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-500/15 text-amber-400 border border-amber-500/20">Новое</span>`;

                return `
                    <div class="bg-white dark:bg-[#111625] rounded-2xl border ${item.needHelp ? 'border-rose-500/40' : 'border-slate-200 dark:border-slate-800'} p-5 shadow-sm space-y-4 animate-fade-in">
                        <!-- a) Точный Telegram @username + время + фиксированный этап -->
                        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 dark:border-slate-800/80 pb-3">
                            <div class="flex flex-wrap items-center gap-2.5">
                                <a href="https://t.me/${encodeURIComponent(cleanTgUser)}" target="_blank" rel="noopener noreferrer" class="font-extrabold text-sm sm:text-base text-indigo-500 dark:text-indigo-400 hover:underline flex items-center gap-1.5">
                                    <i class="fa-brands fa-telegram"></i>
                                    ${escapeHtml(item.username)}
                                </a>
                                <span class="text-xs text-slate-400">• ${escapeHtml(item.stage || FIXED_STAGE)}</span>
                                <span class="text-xs text-slate-500">• ${dateStr}</span>
                            </div>

                            <div class="flex items-center gap-2">
                                ${statusBadge}
                                <button type="button" onclick="toggleSubmissionStatus('${item.id}')" class="px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-semibold transition">
                                    ${isDone ? 'Вернуть в новые' : 'Отметить разобранным'}
                                </button>
                                <button type="button" onclick="deleteSubmission('${item.id}')" class="p-1.5 rounded-lg text-slate-400 hover:text-rose-500 transition" title="Удалить анкету">
                                    <i class="fa-solid fa-trash-can text-xs"></i>
                                </button>
                            </div>
                        </div>

                        <!-- b) Блок 1 — Оценки -->
                        <div class="space-y-1.5">
                            <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Блок 1 — Оценки:</div>
                            <div class="flex flex-wrap gap-1.5">
                                ${ratingPills}
                            </div>
                        </div>

                        <!-- c) Выбранные сложности (простые плашки без авто-текста) -->
                        <div class="space-y-1.5">
